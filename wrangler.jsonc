{
  // Static-assets Worker serving the Vite build, plus the /api routes that
  // replaced the self-hosted Mautic. Deploy with:
  //     npm run build && npx wrangler deploy
  //
  // Pushing to GitHub does NOT deploy — this Worker has no git connection.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paired-wellness",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router owns /about, /skincare, /guides — unmatched paths must fall
    // back to index.html rather than 404.
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback would swallow /api/* before the Worker ever
    // ran, and the form would post into a copy of the homepage.
    "run_worker_first": ["/api/*"]
  },

  // Two patterns, deliberately. The wildcard matches subdomains only — it is why
  // www worked while the bare apex returned a 522 — so the apex needs its own
  // entry. Routes here are authoritative on every deploy; add new ones to this
  // file rather than in the dashboard.
  "routes": [
    { "pattern": "thepairedwellness.com/*", "zone_name": "thepairedwellness.com" },
    { "pattern": "*.thepairedwellness.com/*", "zone_name": "thepairedwellness.com" }
  ],

  // Nurture sequence. Daily at 14:00 UTC (10am ET) — a send time, not a
  // schedule the contact sees; each contact advances at most one step per run.
  "triggers": {
    "crons": ["0 14 * * *"]
  },

  // Non-secret config. BREVO_API_KEY and UNSUB_SECRET are secrets, set with
  // `wrangler secret put` — never here, this file is in git.
  "vars": {
    "SITE_URL": "https://thepairedwellness.com",
    "TEMPLATE_DELIVERY": "1",
    "TEMPLATE_DAY2": "2",
    "TEMPLATE_DAY5": "3"
  }
}
